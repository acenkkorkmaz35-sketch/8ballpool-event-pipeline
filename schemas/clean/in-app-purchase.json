{
    "description": "Clean-events contract for 'in-app-purchase' events, produced by the DQ service (user ids are strings; enrichment fields added).",
    "$schema": "http://json-schema.org/draft-03/schema#",
    "title": "In-app purchase clean event",
    "type": "object",
    "required": true,
    "properties": {
        "event-type": {
            "enum": [
                "in-app-purchase"
            ],
            "required": true
        },
        "time": {
            "type": "integer",
            "minimum": 0,
            "required": true
        },
        "purchase_value": {
            "type": "number",
            "minimum": 0,
            "required": true
        },
        "user-id": {
            "type": "string",
            "required": true,
            "minLength": 1,
            "maxLength": 50
        },
        "product-id": {
            "type": "string",
            "required": true,
            "minLength": 1,
            "maxLength": 100
        },
        "country": {
            "type": "string",
            "required": true,
            "minLength": 1
        },
        "platform": {
            "type": "string",
            "required": true,
            "minLength": 1
        }
    },
    "additionalProperties": false
}
